{
  "name": "gbp",
  "version": "1.0.0",
  "description": "Reward or take away points to contributors based on PR labels.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write **/*.{js,ts}",
    "format-check": "prettier --check **/*.{js,ts}",
    "lint": "eslint",
    "build": "tsc",
    "package": "rollup -c",
    "test": "jest",
    "all": "npm run format && npm run format-check && npm run lint && npm run build && npm run package & npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tgstation/gbp-action"
  },
  "keywords": [
    "actions"
  ],
  "author": "Mothblocks",
  "license": "MPL-2.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.22",
    "toml": "^4.1.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3"
  }
}
